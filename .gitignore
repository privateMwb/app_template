# ============================================================
# .gitignore
# ============================================================

# ============================================================
# C++ (backend/)
# ============================================================

# CMake build directories
build*/
cmake-build-*/
install*/
results*/

# CMake generated files -- these should only ever exist inside
# an out-of-source build*/ directory (see above). Listed
# explicitly too, in case of an accidental in-source build
# (e.g. `cmake -B . -S .`), so they never get committed by
# mistake regardless of where they land.
CMakeFiles/
CMakeCache.txt
CMakeUserPresets.json
cmake_install.cmake
Makefile

# Runtime data generated by the backend at runtime -- keep the
# directory itself tracked (see backend/data/.gitkeep) but
# ignore anything written into it.
backend/data/*
!backend/data/.gitkeep

# Object files
*.o
*.obj

# Executables
*.exe

# Debug symbols
*.pdb

# Static / shared libraries
*.a
*.lib
*.so
*.dll

# Coverage files
*.gcda
*.gcno
*.gcov
coverage.info
coverage.filtered.info
coverage-html/

# ============================================================
# Frontend (frontend/)
# ============================================================

node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-error.log*

# Local env overrides -- e.g. a different API URL for someone's
# machine. Never something to commit; everyone sets their own.
frontend/.env.local
frontend/.env.*.local

# ============================================================
# Docs (docs/)
# ============================================================

# Doxygen (fetched theme + generated output, not committed)
docs/doxygen-awesome-css/
docs/html/

# ============================================================
# Tooling
# ============================================================

# Clang tools
.clangd/
.cache/

# IDE files
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Release tarballs (downloaded locally for hash verification)
*.tar.gz

# NOTE: backend/external/ contains git submodules (see
# .gitmodules), not build artifacts -- do NOT ignore that
# directory. Their own build output still lands under build*/
# above once configured, same as everything else.