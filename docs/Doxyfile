# ============================================================
# docs/Doxyfile
# Generates API reference docs from backend/include and
# backend/src, published to GitHub Pages by
# .github/workflows/docs.yml.
#
# Retargeting for a new app built from this template:
#   - PROJECT_NAME, PROJECT_BRIEF below
#   - Nothing else needs to change unless you rename backend/
#     or backend/external/ themselves.
#
# Only the settings that differ from Doxygen's defaults are listed --
# run `doxygen -g -` to see the full default set if needed.
# ============================================================

# TODO: set these per-app.
PROJECT_NAME            = "App Name"
PROJECT_BRIEF           = "One-line description of what this app does."

OUTPUT_DIRECTORY        = .

INPUT                   = ../backend/include ../backend/src ../README.md
USE_MDFILE_AS_MAINPAGE  = ../README.md
FILE_PATTERNS           = *.h *.tpp *.cpp
RECURSIVE               = YES
# Submodules are untouched, vendored dependencies, not this
# project's own API surface -- never document their sources.
EXCLUDE                 = ../backend/external

# If your headers carry real \brief/\param/\return/\throws
# comments, keep EXTRACT_ALL off -- this makes
# WARN_IF_UNDOCUMENTED actually useful, flagging anything
# genuinely missing instead of staying silent because everything
# is auto-included. Flip EXTRACT_ALL to YES temporarily if you
# want a full dump of undocumented code while writing docs.
EXTRACT_ALL             = NO
WARN_IF_UNDOCUMENTED    = YES

GENERATE_HTML           = YES
GENERATE_LATEX          = NO

# Doxygen Awesome theme (jothepro/doxygen-awesome-css). Not vendored
# in the repo -- fetched fresh into doxygen-awesome-css/ by both the
# CI workflow and the local generation command below.
HTML_EXTRA_STYLESHEET   = doxygen-awesome-css/doxygen-awesome.css \
                          doxygen-awesome-css/doxygen-awesome-sidebar-only.css
HTML_COLORSTYLE         = LIGHT
GENERATE_TREEVIEW       = YES
FULL_SIDEBAR            = NO
DISABLE_INDEX           = NO

# Class/include/collaboration diagrams. Requires Graphviz locally
# (`pkg install graphviz` on Termux) -- harmless if missing, Doxygen
# just skips diagram generation with a warning.
HAVE_DOT                = YES
DOT_IMAGE_FORMAT        = svg
INTERACTIVE_SVG         = YES

QUIET                   = NO